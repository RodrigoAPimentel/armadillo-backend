# This is a sample environment configuration file for the Armadillo project.
# It contains various environment variables used to configure the backend, frontend, 
# and associated services such as MongoDB, Nginx, and the ELK stack.

NODE_ENV= # The environment in which the application is running (e.g., development, production). [development]
# --- 
PROJECT_NAME= # The name of the project. [armadillo]
PROJECT_VERSION= # The current version of the project. [0.0.1]
# --- 
PROJECT_LOGS_DIR= # Directory where project logs are stored. [/var/log/app]
# --- 
NODE_TLS_REJECT_UNAUTHORIZED= # Whether to reject unauthorized TLS connections (0 to disable). [0]
TZ= # Timezone for the application. [America/Sao_Paulo]
# --- 
ENCRYPTION_KEY= # A 32-byte key used for encryption. USE https://passwordsgenerator.net/ TO GENERATE KEY
ENCRYPTION_IV_LENGTH= # Length of the initialization vector for encryption. [16]

################################# BACKEND #################################
BACKEND_SERVICE_NAME= # Name of the backend service. [backend]
BACKEND_NAME= # Full name of the backend service. [$PROJECT_NAME-$BACKEND_SERVICE_NAME]
BACKEND_VERSION= # Version of the backend service. [0.0.1]
# --- 
BACKEND_URL= # URL of the backend service. [$BACKEND_SERVICE_NAME]
BACKEND_PORT= # Port on which the backend service runs. [5000]
BACKEND_HOST= # Host address of the backend service. [$BACKEND_URL:$BACKEND_PORT]
BACKEND_STATUS_URL= # URL path for checking backend status. [status]
# --- 
BACKEND_LOGS_DIR= # Directory where backend logs are stored. [$PROJECT_LOGS_DIR/backend]
# --- 
AUTH_SECRET= # Secret key used for authentication.
AUTH_EXPIRESIN= # Expiration time for authentication tokens. [7d]

################################# BACKEND #################################
FRONTEND_SERVICE_NAME= # Name of the frontend service. [frontend]
FRONTEND_NAME= # Full name of the frontend service. [$PROJECT_NAME-$FRONTEND_SERVICE_NAME]
FRONTEND_VERSION= # Version of the frontend service. [0.0.1]
# --- 
FRONTEND_URL= # URL of the frontend service. [/]
FRONTEND_PORT= # Port on which the frontend service runs. [3000]
FRONTEND_HOST= # Host address of the frontend service. [$FRONTEND_URL:$FRONTEND_PORT]
# --- 
FRONTEND_LOGS_DIR= # Directory where frontend logs are stored. [$PROJECT_LOGS_DIR/frontend]

################################# MONGODB #################################
MONGO_SERVICE_NAME= # Name of the MongoDB service. [mongodb]
MONGO_IMAGE= # Docker image for MongoDB. [mongodb/mongodb-community-server]
MONGO_VERSION= # Version of the MongoDB image. [7.0.3-ubuntu2204]
# --- 
MONGO_URL= # URL of the MongoDB service. [$MONGO_SERVICE_NAME]
MONGO_PORT= # Port on which MongoDB runs. [27017]
MONGO_HOST= # Host address of the MongoDB service. [$MONGO_URL:$MONGO_PORT]
# --- 
MONGO_ROOT_USER= # Root username for MongoDB.
MONGO_ROOT_PASS= # Root password for MongoDB.
# --- 
MONGO_DB_NAME= # Name of the MongoDB database. [$PROJECT_NAME]

################################# MONGO EXPRESS #################################
MONGO_EXPRESS_SERVICE_NAME= # Name of the Mongo Express service. [mongodb-express]
MONGO_EXPRESS_IMAGE= # Docker image for Mongo Express. [mongo-express]
MONGO_EXPRESS_VERSION= # Version of the Mongo Express image. [1.0.0-20-alpine3.18]
# --- 
MONGO_EXPRESS_URL= # URL of the Mongo Express service. [$MONGO_EXPRESS_SERVICE_NAME]
MONGO_EXPRESS_PORT= # Port on which Mongo Express runs. [8081]
MONGO_EXPRESS_HOST= # Host address of the Mongo Express service. [$MONGO_EXPRESS_URL:$MONGO_EXPRESS_PORT]
# --- 
MONGO_EXPRESS_USER= # Username for Mongo Express.
MONGO_EXPRESS_PASS= # Password for Mongo Express.

################################# NGINX #################################
NGINX_SERVICE_NAME= # Name of the Nginx service. [nginx]
NGINX_IMAGE= # Docker image for Nginx. [nginx]
NGINX_VERSION= # Version of the Nginx image. [1.21.1]
# --- 
NGINX_SERVER_NAME= # Server name for Nginx. [_]
NGINX_URL= # URL of the Nginx service. [$NGINX_SERVICE_NAME]
NGINX_HTTP_PORT= # HTTP port for Nginx. [80]
NGINX_HTTPS_PORT= # HTTPS port for Nginx. [443]
NGINX_HOST= # Host address of the Nginx service. [$NGINX_URL:$NGINX_HTTP_PORT]
# --- 
NGINX_LOGS_DIR= # Directory where Nginx logs are stored. [/var/log/nginx]
# --- 
NGINX_STATUS_URL= # URL path for checking Nginx status. [nginx/status]
# --- 
NGINX_BACKEND_URL= # URL path for backend status through Nginx. [$BACKEND_SERVICE_NAME/$BACKEND_STATUS_URL]
NGINX_BACKEND_HOST= # Host address of the backend service through Nginx. [$BACKEND_SERVICE_NAME:$BACKEND_PORT]
# --- 
NGINX_FRONTEND_URL= # URL path for frontend through Nginx. [/]
NGINX_FRONTEND_HOST= # Host address of the frontend service through Nginx. [$FRONTEND_SERVICE_NAME:$FRONTEND_PORT]

################################# OBSERVABILITY (ELK) #################################
ELK_VERSION= # Version of the ELK stack. [7.13.3]
# --- elasticsearch
ELK_SERVICE_NAME= # Name of the Elasticsearch service. [elasticsearch]
ELK_IMAGE= # Docker image for Elasticsearch. [elastic/elasticsearch]
# -
ELK_ELASTICSEARCH_URL= # URL of the Elasticsearch service. [elasticsearch]
ELK_ELASTICSEARCH_PORT1= # Primary port for Elasticsearch. [9200]
ELK_ELASTICSEARCH_PORT2= # Secondary port for Elasticsearch. [9300]
ELK_ELASTICSEARCH_HOST= # Host address of the Elasticsearch service. [$ELK_ELASTICSEARCH_URL:$ELK_ELASTICSEARCH_PORT1]
# -
ELK_ELASTICSEARCH_USER= # Username for Elasticsearch. [elastic]
ELK_ELASTICSEARCH_PASSWORD= # Password for Elasticsearch.
# --- Metricbeat
METRICBEAT_SERVICE_NAME= # Name of the Metricbeat service. [metricbeat]
METRICBEAT_IMAGE= # Docker image for Metricbeat. [elastic/metricbeat]
# -
METRICBEAT_PORT= # Port on which Metricbeat runs. [5067]
METRICBEAT_HOST= # Host address of the Metricbeat service. [$METRICBEAT_SERVICE_NAME:$METRICBEAT_PORT]
# --- Filebeat
FILEBEAT_SERVICE_NAME= # Name of the Filebeat service. [filebeat]
FILEBEAT_IMAGE= # Docker image for Filebeat. [elastic/filebeat]
# -
FILEBEAT_PORT= # Port on which Filebeat runs. [5066]
FILEBEAT_HOST= # Host address of the Filebeat service. [$FILEBEAT_SERVICE_NAME:$FILEBEAT_PORT]
# --- Kibana
KIBANA_SERVICE_NAME= # Name of the Kibana service. [kibana]
KIBANA_IMAGE= # Docker image for Kibana. [elastic/kibana]
# -
ELK_KIBANA_URL= # URL of the Kibana service. [kibana]
ELK_KIBANA_PORT= # Port on which Kibana runs. [5601]
ELK_KIBANA_HOST= # Host address of the Kibana service. [$ELK_KIBANA_URL:$ELK_KIBANA_PORT]
ELK_KIBANA_SIMPLE_HOST= # Simple host address for Kibana. [0.0.0.0]
# --- Heartbeat
HEARTBEAT_SERVICE_NAME= # Name of the Heartbeat service. [heartbeat]
HEARTBEAT_IMAGE= # Docker image for Heartbeat. [docker.elastic.co/beats/heartbeat]
# -
HEARTBEAT_PORT= # Port on which Heartbeat runs. [5068]
HEARTBEAT_HOST= # Host address of the Heartbeat service. [$HEARTBEAT_SERVICE_NAME:$HEARTBEAT_PORT]
